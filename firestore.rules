rules_version = '2';
// 카페인24 크리스마스 럭키룰렛 · Firestore 보안 규칙 (2026-11-04 최신화 · 매장당 200장 · 210개 매장)
// 11/4 변경: 등수를 tiers 컬렉션으로 분리(스티커를 쓴 뒤에만 읽힘) · 참여 가능 날짜를 서버에서 강제 · 집계/선착순 카운터를 실제 기록과 묶음
// 등수: 1~4 포인트 · 5 꽝 · 6 다라미 텀블러 · 7 다라미 양산
// Firebase 콘솔 → Firestore Database → 규칙 탭: 전체를 지우고 이 파일 내용을 통째로 붙여넣고 '게시'.
//
// 스티커 1장 = 고유 QR 1개 = 룰렛 1번
//  ① codes 잠금 + phones 기록 (등수 모름) → ② tiers 읽기(잠근 뒤에만) → ③ entries + wins + stats 한 번에 기록
// 꽝(5등)이면: 만족도 조사(번호당 1번, surveys/{번호} + surveyed/{번호}) → 응모권 룰렛 → 당첨이면 claims/{번호}(번호당 1번, 선착순 240명)
// 당첨(1~4·6·7)이면 wins/{스티커번호}에 번호 뒤 4자리만 남겨 화면의 당첨 롤링에 씀
// 같은 휴대폰 번호로 여러 스티커 참여 가능
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 공통 ----------
    // 관리자 = 구글 로그인 + 이메일이 @cafein24.co.kr
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@cafein24[.]co[.]kr$');
    }
    // 휴대폰 번호: 010으로 시작하는 11자리
    function isPhone(p) { return p is string && p.matches('010[0-9]{8}'); }
    function prizeOf(tier) { return {'1': 50000, '2': 10000, '3': 5000, '4': 1000, '5': 0, '6': 0, '7': 0}[string(tier)]; }
    function changedOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function docOf(c, id) { return /databases/$(database)/documents/$(c)/$(id); }
    function maskOf(p) { return p[0:3] + '-****-' + p[7:11]; }
    // 참여 가능 시간 (한국 시간 = UTC+9). 테스트: 12/7까지 · 본 기간: 12/18 0시 ~ 12/27 24시
    function kst(y, m, d) { return timestamp.date(y, m, d) - duration.value(9, 'h'); }
    function canPlay() {
      return request.time < kst(2026, 12, 8)
        || (request.time >= kst(2026, 12, 18) && request.time < kst(2026, 12, 28));
    }
    // 설문·응모권은 종료 다음 날 아침 6시까지 (마지막 날 밤 꽝 손님용 여유)
    function canBonus() {
      return request.time < kst(2026, 12, 8)
        || (request.time >= kst(2026, 12, 18) && request.time < kst(2026, 12, 28) + duration.value(6, 'h'));
    }

    // ---------- 매장 ----------
    match /stores/{code} {                 // 공개용: 매장명·지역만
      allow get: if true;
      allow list, write: if isAdmin();
    }
    match /storesPrivate/{code} {          // 점주명·연락처·담당SV: 본사만
      allow read, write: if isAdmin();
    }

    // ---------- 스티커 ----------
    // codes: 매장·사용 여부·묶음·컵 (등수 없음) — 손님은 1건 읽기 + used:false → true 로 1번 잠그기만
    match /codes/{code} {
      allow get: if true;
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin() || (
        canPlay()
        && resource.data.used == false
        && request.resource.data.used == true
        && changedOnly(['used', 'usedAt'])
        && request.resource.data.usedAt == request.time
        && !exists(docOf('phones', code))
        && existsAfter(docOf('phones', code))
      );
    }
    // tiers: 등수는 여기에만. 스티커를 잠근 뒤에만 읽을 수 있어 미리 골라낼 수 없음
    match /tiers/{code} {
      allow get: if isAdmin() || get(docOf('codes', code)).data.used == true;
      allow list, write: if isAdmin();
    }

    // 참여 기록 (가린 번호만): 같은 순간에 스티커를 잠가야 만들 수 있고, 등수·매장은 스티커와 같아야 함
    match /entries/{code} {
      allow get: if true;
      allow list, delete: if isAdmin();
      allow create: if isAdmin() || (
        request.resource.data.code == code
        && request.resource.data.keys().hasOnly(['code','store','storeName','tier','money','label','phoneMask','agreeMarketing','createdAt','surveyDone','bonusDone','bonus'])
        && get(docOf('codes', code)).data.used == true
        && request.resource.data.tier == get(docOf('tiers', code)).data.tier
        && request.resource.data.store == get(docOf('codes', code)).data.store
        && request.resource.data.tier in [1, 2, 3, 4, 5, 6, 7]
        && request.resource.data.money == prizeOf(request.resource.data.tier)
        && request.resource.data.phoneMask == maskOf(get(docOf('phones', code)).data.phone)
        && request.resource.data.agreeMarketing is bool
        && request.resource.data.surveyDone == false
        && request.resource.data.bonusDone == false
        && request.resource.data.bonus == 0
        && request.resource.data.createdAt == request.time
        && getAfter(docOf('stats', 'store_' + request.resource.data.store)).data.last == code
      );
      // 꽝 스티커만: 설문 완료(1번) · 응모권 결과(1번)
      allow update: if isAdmin() || canBonus() && ((
        resource.data.tier == 5
        && changedOnly(['surveyDone'])
        && resource.data.surveyDone == false
        && request.resource.data.surveyDone == true
        && existsAfter(/databases/$(database)/documents/surveys/$(get(/databases/$(database)/documents/phones/$(code)).data.phone))
      ) || (
        resource.data.tier == 5
        && changedOnly(['bonusDone', 'bonus'])
        && resource.data.surveyDone == true
        && resource.data.bonusDone == false
        && request.resource.data.bonusDone == true
        && (request.resource.data.bonus == 0
            || (request.resource.data.bonus == 1000
                && existsAfter(/databases/$(database)/documents/claims/$(get(/databases/$(database)/documents/phones/$(code)).data.phone))))
      ));
    }

    // 손님 휴대폰 번호 원본: 본사만 읽기. 스티커를 잠그는 같은 순간에 1번만 생성
    match /phones/{code} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['phone','store','createdAt'])
        && isPhone(request.resource.data.phone)
        && request.resource.data.store == get(docOf('codes', code)).data.store
        && get(docOf('codes', code)).data.used == false
        && getAfter(docOf('codes', code)).data.used == true
        && request.resource.data.createdAt == request.time
      );
    }

    // ---------- 꽝 손님 설문 · 응모권 ----------
    // 설문 (문서 이름 = 휴대폰 번호 → 번호당 1번): 꽝 스티커를 그 번호로 돌린 사람만
    match /surveys/{phone} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || (
        canBonus()
        && isPhone(phone)
        && request.resource.data.phone == phone
        && request.resource.data.keys().hasOnly(['phone','code','store','q1','q2','q3','q4','q5','q6','q7','q8','q9','q10','q11','q12','q13','q14','q15','q16','q17','etc3','etc7','etc10','etc13','etc15','createdAt'])
        && get(/databases/$(database)/documents/entries/$(request.resource.data.code)).data.tier == 5
        && get(/databases/$(database)/documents/phones/$(request.resource.data.code)).data.phone == phone
        && request.resource.data.store == get(/databases/$(database)/documents/entries/$(request.resource.data.code)).data.store
        && existsAfter(/databases/$(database)/documents/surveyed/$(phone))
        && request.resource.data.createdAt == request.time
      );
    }
    // '이 번호는 설문 완료' 표시 (내용 없음): 다른 꽝 스티커에서 설문 버튼을 숨길 때 확인
    match /surveyed/{phone} {
      allow get: if true;
      allow list, update, delete: if isAdmin();
      allow create: if isAdmin() || (
        isPhone(phone)
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at == request.time
        && existsAfter(/databases/$(database)/documents/surveys/$(phone))
      );
    }
    // 응모권 당첨 1,000P (문서 이름 = 휴대폰 번호 → 번호당 1번): 설문을 마친 꽝 스티커, 같은 순간에 선착순 카운터 +1
    match /claims/{phone} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || (
        canBonus()
        && isPhone(phone)
        && request.resource.data.phone == phone
        && request.resource.data.keys().hasOnly(['phone','code','store','storeName','amount','src','createdAt'])
        && request.resource.data.amount == 1000
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/phones/$(request.resource.data.code)).data.phone == phone
        && get(/databases/$(database)/documents/entries/$(request.resource.data.code)).data.tier == 5
        && get(/databases/$(database)/documents/entries/$(request.resource.data.code)).data.surveyDone == true
        && get(/databases/$(database)/documents/entries/$(request.resource.data.code)).data.bonusDone == false
        && request.resource.data.store == get(/databases/$(database)/documents/entries/$(request.resource.data.code)).data.store
        && getAfter(/databases/$(database)/documents/entries/$(request.resource.data.code)).data.bonus == 1000
        && getAfter(/databases/$(database)/documents/stats/bonus).data.wins == get(/databases/$(database)/documents/stats/bonus).data.wins + 1
        && getAfter(/databases/$(database)/documents/stats/bonus).data.last == phone
      );
    }

    // ---------- 당첨 롤링 (공개 · 번호 뒤 4자리만) ----------
    // 참여 기록(entries)을 만드는 같은 순간에만, 그 스티커의 실제 등수(꽝 제외)·실제 번호 뒤 4자리로 1번 생성
    match /wins/{code} {
      allow read: if true;
      allow update, delete: if isAdmin();
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['tail','tier','createdAt'])
        && request.resource.data.tier == get(docOf('tiers', code)).data.tier
        && request.resource.data.tier != 5
        && request.resource.data.tail == get(docOf('phones', code)).data.phone[7:11]
        && !exists(docOf('entries', code))
        && existsAfter(docOf('entries', code))
        && request.resource.data.createdAt == request.time
      );
    }

    // ---------- 집계 (개인정보 없음 · 누구나 읽기) ----------
    match /stats/{id} {
      allow read: if true;
      allow delete: if isAdmin();
    }
    // 응모권 1,000P 선착순 카운터: claims(번호당 1번)를 새로 만드는 같은 순간에만 +1, 240 넘으면 거부
    match /stats/bonus {
      allow create, update: if isAdmin() || (
        request.resource.data.keys().hasOnly(['wins','last'])
        && request.resource.data.wins == (resource == null ? 0 : resource.data.wins) + 1
        && request.resource.data.wins <= 240
        && request.resource.data.last is string
        && !exists(docOf('claims', request.resource.data.last))
        && existsAfter(docOf('claims', request.resource.data.last))
      );
    }
    // 매장별 집계 (점주 페이지용): 참여 기록(entries)을 새로 만드는 같은 순간에만, 그 기록 그대로 +1
    match /stats/{storeStat} {
      function statOk(prev) {
        let e = getAfter(docOf('entries', request.resource.data.last)).data;
        return storeStat.matches('store_[0-9]{3}')
          && request.resource.data.keys().hasOnly(['scans','wins','amount','last'])
          && request.resource.data.last is string
          && !exists(docOf('entries', request.resource.data.last))
          && storeStat == 'store_' + e.store
          && request.resource.data.scans == prev.scans + 1
          && request.resource.data.wins == prev.wins + (e.tier == 5 ? 0 : 1)
          && request.resource.data.amount == prev.amount + e.money;
      }
      allow create: if isAdmin() || statOk({'scans': 0, 'wins': 0, 'amount': 0});
      allow update: if isAdmin() || statOk(resource.data);
    }

    // 그 밖의 모든 경로는 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
