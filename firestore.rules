rules_version = '2';
// 카페인24 크리스마스 럭키룰렛 · Firestore 보안 규칙 (모든 스티커 고유 QR)
// Firebase 콘솔 → Firestore Database → 규칙 탭: 전체를 지우고 이 파일 내용을 통째로 붙여넣고 '게시'.
//
// 스티커 1장 = 고유 QR 1개 = 룰렛 1번 (codes 잠금 + entries + phones 를 한 번에 기록)
// 꽝(5등)이면: 설문(번호당 1번, surveys/{번호} + surveyed/{번호}) → 응모권 룰렛 → 당첨이면 claims/{번호}(번호당 1번)
// 같은 휴대폰 번호로 여러 스티커 참여 가능
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 공통 ----------
    // 관리자 = 구글 로그인 + 이메일이 @cafein24.co.kr
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@cafein24[.]co[.]kr$');
    }
    // 휴대폰 번호: 010으로 시작하는 11자리
    function isPhone(p) { return p is string && p.matches('010[0-9]{8}'); }
    function prizeOf(tier) { return {'1': 50000, '2': 10000, '3': 5000, '4': 1000, '5': 0}[string(tier)]; }
    function changedOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // ---------- 매장 ----------
    match /stores/{code} {                 // 공개용: 매장명·지역만
      allow get: if true;
      allow list, write: if isAdmin();
    }
    match /storesPrivate/{code} {          // 점주명·연락처·담당SV: 본사만
      allow read, write: if isAdmin();
    }

    // ---------- 스티커 ----------
    // 손님: 번호 1건 읽기 + used:false → true 로 1번 잠그기만 (등수는 못 바꿈)
    match /codes/{code} {
      allow get: if true;
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin() || (
        resource.data.used == false
        && request.resource.data.used == true
        && changedOnly(['used', 'usedAt'])
        && request.resource.data.usedAt == request.time
        && existsAfter(/databases/$(database)/documents/entries/$(code))
      );
    }

    // 참여 기록 (가린 번호만): 같은 순간에 스티커를 잠가야 만들 수 있고, 등수·매장은 스티커와 같아야 함
    match /entries/{code} {
      allow get: if true;
      allow list, delete: if isAdmin();
      allow create: if isAdmin() || (
        request.resource.data.code == code
        && request.resource.data.keys().hasOnly(['code','store','storeName','tier','money','label','phoneMask','agreeMarketing','createdAt','surveyDone','bonusDone','bonus'])
        && get(/databases/$(database)/documents/codes/$(code)).data.used == false
        && getAfter(/databases/$(database)/documents/codes/$(code)).data.used == true
        && request.resource.data.tier == get(/databases/$(database)/documents/codes/$(code)).data.tier
        && request.resource.data.store == get(/databases/$(database)/documents/codes/$(code)).data.store
        && request.resource.data.tier in [1, 2, 3, 4, 5]
        && request.resource.data.money == prizeOf(request.resource.data.tier)
        && request.resource.data.phoneMask is string && request.resource.data.phoneMask.size() <= 13
        && request.resource.data.agreeMarketing is bool
        && request.resource.data.surveyDone == false
        && request.resource.data.bonusDone == false
        && request.resource.data.bonus == 0
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/phones/$(code))
      );
      // 꽝 스티커만: 설문 완료(1번) · 응모권 결과(1번)
      allow update: if isAdmin() || (
        resource.data.tier == 5
        && changedOnly(['surveyDone'])
        && resource.data.surveyDone == false
        && request.resource.data.surveyDone == true
        && existsAfter(/databases/$(database)/documents/surveys/$(get(/databases/$(database)/documents/phones/$(code)).data.phone))
      ) || (
        resource.data.tier == 5
        && changedOnly(['bonusDone', 'bonus'])
        && resource.data.surveyDone == true
        && resource.data.bonusDone == false
        && request.resource.data.bonusDone == true
        && (request.resource.data.bonus == 0
            || (request.resource.data.bonus == 1000
                && existsAfter(/databases/$(database)/documents/claims/$(get(/databases/$(database)/documents/phones/$(code)).data.phone))))
      );
    }

    // 손님 휴대폰 번호 원본: 본사만 읽기. 스티커를 잠그는 같은 순간에 1번만 생성
    match /phones/{code} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['phone','store','createdAt'])
        && isPhone(request.resource.data.phone)
        && request.resource.data.store == get(/databases/$(database)/documents/codes/$(code)).data.store
        && get(/databases/$(database)/documents/codes/$(code)).data.used == false
        && getAfter(/databases/$(database)/documents/codes/$(code)).data.used == true
        && existsAfter(/databases/$(database)/documents/entries/$(code))
        && request.resource.data.createdAt == request.time
      );
    }

    // ---------- 꽝 손님 설문 · 응모권 ----------
    // 설문 (문서 이름 = 휴대폰 번호 → 번호당 1번): 꽝 스티커를 그 번호로 돌린 사람만
    match /surveys/{phone} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || (
        isPhone(phone)
        && request.resource.data.phone == phone
        && request.resource.data.keys().hasOnly(['phone','code','store','q1','q2','q3','q4','q5','q6','q7','q8','createdAt'])
        && get(/databases/$(database)/documents/entries/$(request.resource.data.code)).data.tier == 5
        && get(/databases/$(database)/documents/phones/$(request.resource.data.code)).data.phone == phone
        && request.resource.data.store == get(/databases/$(database)/documents/entries/$(request.resource.data.code)).data.store
        && existsAfter(/databases/$(database)/documents/surveyed/$(phone))
        && request.resource.data.createdAt == request.time
      );
    }
    // '이 번호는 설문 완료' 표시 (내용 없음): 다른 꽝 스티커에서 설문 버튼을 숨길 때 확인
    match /surveyed/{phone} {
      allow get: if true;
      allow list, update, delete: if isAdmin();
      allow create: if isAdmin() || (
        isPhone(phone)
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at == request.time
        && existsAfter(/databases/$(database)/documents/surveys/$(phone))
      );
    }
    // 응모권 당첨 1,000P (문서 이름 = 휴대폰 번호 → 번호당 1번): 설문을 마친 꽝 스티커, 같은 순간에 선착순 카운터 +1
    match /claims/{phone} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || (
        isPhone(phone)
        && request.resource.data.phone == phone
        && request.resource.data.keys().hasOnly(['phone','code','store','storeName','amount','src','createdAt'])
        && request.resource.data.amount == 1000
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/phones/$(request.resource.data.code)).data.phone == phone
        && get(/databases/$(database)/documents/entries/$(request.resource.data.code)).data.tier == 5
        && get(/databases/$(database)/documents/entries/$(request.resource.data.code)).data.surveyDone == true
        && get(/databases/$(database)/documents/entries/$(request.resource.data.code)).data.bonusDone == false
        && request.resource.data.store == get(/databases/$(database)/documents/entries/$(request.resource.data.code)).data.store
        && getAfter(/databases/$(database)/documents/entries/$(request.resource.data.code)).data.bonus == 1000
        && getAfter(/databases/$(database)/documents/stats/bonus).data.wins == get(/databases/$(database)/documents/stats/bonus).data.wins + 1
      );
    }

    // ---------- 집계 (개인정보 없음 · 누구나 읽기) ----------
    match /stats/{id} {
      allow read: if true;
      allow delete: if isAdmin();
    }
    // 응모권 1,000P 선착순 카운터: 1씩만, 1,200 넘으면 거부
    match /stats/bonus {
      allow create: if isAdmin() || (request.resource.data.keys().hasOnly(['wins']) && request.resource.data.wins == 1);
      allow update: if isAdmin() || (
        changedOnly(['wins'])
        && request.resource.data.wins == resource.data.wins + 1
        && request.resource.data.wins <= 1200
      );
    }
    // 매장별 집계 (점주 페이지용): scans +1, wins +0/1, amount +당첨금
    match /stats/{storeStat} {
      allow create: if isAdmin() || (
        storeStat.matches('store_[0-9]{3}')
        && request.resource.data.keys().hasOnly(['scans','wins','amount'])
        && request.resource.data.scans == 1
        && request.resource.data.wins in [0, 1]
        && request.resource.data.amount in [0, 1000, 5000, 10000, 50000]
      );
      allow update: if isAdmin() || (
        storeStat.matches('store_[0-9]{3}')
        && changedOnly(['scans','wins','amount'])
        && request.resource.data.scans == resource.data.scans + 1
        && (request.resource.data.wins - resource.data.wins) in [0, 1]
        && (request.resource.data.amount - resource.data.amount) in [0, 1000, 5000, 10000, 50000]
      );
    }

    // 그 밖의 모든 경로는 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
