rules_version = '2';
// 카페인24 크리스마스 룰렛 · Firestore 보안 규칙
// Firebase 콘솔 → Firestore Database → 규칙 탭에 전체를 붙여넣고 '게시'.
// ※ 테스트 모드는 2026-11-11에 만료되므로 그 전에 반드시 이 규칙으로 교체합니다.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 공통 ----------
    // 관리자 = 구글 로그인 + 이메일이 @cafein24.co.kr
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@cafein24[.]co[.]kr$');
    }
    function isPhone(p) { return p is string && p.size() == 11 && p.matches('01[0-9]{9}'); }
    function prizeOf(tier) { return {'1': 50000, '2': 10000, '3': 5000, '4': 1000, '5': 0}[string(tier)]; }
    function changedOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // ---------- 매장 (공개용: 매장명·지역만) ----------
    // 손님: 매장 1건 읽기(매장명 표시용). 점주 이름·연락처는 여기에 두지 않음.
    match /stores/{code} {
      allow get: if true;
      allow list, write: if isAdmin();
    }
    // ---------- 매장 비공개 정보 (점주명·연락처·담당SV) : 본사만 ----------
    match /storesPrivate/{code} {
      allow read, write: if isAdmin();
    }

    // ---------- 손님 전화번호 (문서 id = 스티커 번호) : 본사만 읽기 ----------
    match /phones/{code} {
      allow read, update, delete: if isAdmin();
      // 당첨 스티커로 룰렛을 돌린 뒤, 번호를 입력할 때 1번만 만들 수 있음 (이미 있으면 거부)
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['phone','store','createdAt'])
        && isPhone(request.resource.data.phone)
        && request.resource.data.store == get(/databases/$(database)/documents/codes/$(code)).data.store
        && get(/databases/$(database)/documents/codes/$(code)).data.used == true
        && get(/databases/$(database)/documents/entries/$(code)).data.tier < 5
        && getAfter(/databases/$(database)/documents/entries/$(code)).data.claimed == true
        && request.resource.data.createdAt == request.time
      );
    }

    // ---------- 스티커 번호 (60,000개) ----------
    // 손님: 번호 1건 읽기 + used:false → true 로 딱 한 번 잠그기만 가능. 등수(tier)는 절대 못 바꿈.
    match /codes/{code} {
      allow get: if true;
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin() || (
        resource.data.used == false
        && request.resource.data.used == true
        && changedOnly(['used', 'usedAt'])
        && request.resource.data.usedAt == request.time
      );
    }

    // ---------- 참여 기록 (룰렛 1회 = 1건, 문서 id = 스티커 번호) ----------
    match /entries/{code} {
      // 손님: 자기 스티커 번호로 1건만 읽기(재접속 시 '내 당첨 내역'). 전체 목록은 관리자만.
      allow get: if true;
      allow list, delete: if isAdmin();
      // 만들 때: 같은 트랜잭션에서 잠근 codes 문서의 등수·매장과 반드시 일치해야 함
      allow create: if isAdmin() || (
        request.resource.data.code == code
        && request.resource.data.keys().hasOnly(['code','store','storeName','tier','money','label','createdAt','surveyDone','bonusMoney','claimed'])
        && request.resource.data.tier == getAfter(/databases/$(database)/documents/codes/$(code)).data.tier
        && request.resource.data.store == getAfter(/databases/$(database)/documents/codes/$(code)).data.store
        && getAfter(/databases/$(database)/documents/codes/$(code)).data.used == true
        && request.resource.data.claimed == false
        && request.resource.data.tier in [1, 2, 3, 4, 5]
        && request.resource.data.money == prizeOf(request.resource.data.tier)
        && request.resource.data.surveyDone == false
        && request.resource.data.bonusMoney == 0
        && request.resource.data.createdAt == request.time
      );
      // 고칠 때: 번호 입력 완료(1회) · 설문 완료 표시(1회) · 보너스 결과 기록(1회)만
      allow update: if isAdmin() || (
        (
          changedOnly(['claimed', 'phoneMask', 'agreeMarketing'])
          && resource.data.claimed == false
          && request.resource.data.claimed == true
          && resource.data.tier < 5
          && request.resource.data.phoneMask is string && request.resource.data.phoneMask.size() <= 13
          && request.resource.data.agreeMarketing is bool
          && existsAfter(/databases/$(database)/documents/phones/$(code))
        ) || (
          changedOnly(['surveyDone'])
          && resource.data.surveyDone == false
          && request.resource.data.surveyDone == true
        ) || (
          changedOnly(['bonusMoney', 'bonusAt'])
          && resource.data.surveyDone == true
          && !('bonusAt' in resource.data)
          && request.resource.data.bonusMoney in [0, 1000]
          && request.resource.data.bonusAt == request.time
        )
      );
    }

    // ---------- 설문 ----------
    // 당첨 손님: 문서 id = 휴대폰 번호 → 번호당 1회
    // 꽝 손님: 문서 id = lose_무작위 → 번호 없이 저장 (당첨되면 claims 에 번호·지점)
    match /surveys/{phone} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin() || (
        phone.matches('lose_[A-Za-z0-9]{20}')
        && request.resource.data.src == 'lose'
        && request.resource.data.keys().hasOnly(['src','store','code','q1','q2','q3','q4','q5','q6','q7','q8','createdAt'])
        && request.resource.data.createdAt == request.time
      ) || (
        isPhone(phone)
        && request.resource.data.phone == phone
        && request.resource.data.code is string
        && get(/databases/$(database)/documents/phones/$(request.resource.data.code)).data.phone == phone
        && request.resource.data.createdAt == request.time
      );
      allow update: if isAdmin();
    }

    // ---------- 꽝 손님 설문 감사 포인트 신청 (문서 id = 휴대폰 번호 → 번호당 1회) ----------
    // 조건: 당첨 스티커 설문으로 이미 참여한 번호는 안 됨 · 같은 순간에 선착순 카운터(stats/bonus)를 1 올려야 함 (1,200 넘으면 거부)
    match /claims/{phone} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || (
        isPhone(phone)
        && request.resource.data.phone == phone
        && request.resource.data.keys().hasOnly(['phone','store','storeName','amount','src','code','agreeMarketing','createdAt'])
        && request.resource.data.store is string && request.resource.data.store.matches('[0-9]{3}')
        && exists(/databases/$(database)/documents/stores/$(request.resource.data.store))
        && request.resource.data.amount == 1000
        && request.resource.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/surveys/$(phone))
        && getAfter(/databases/$(database)/documents/stats/bonus).data.wins == get(/databases/$(database)/documents/stats/bonus).data.wins + 1
      );
    }

    // ---------- 집계 ----------
    match /stats/{id} {
      allow read: if true;
      allow delete: if isAdmin();
    }
    // 보너스 룰렛 당첨 한도 카운터: wins 를 1씩만 올릴 수 있고 1,200을 넘지 못함
    match /stats/bonus {
      allow create: if isAdmin() || (request.resource.data.keys().hasOnly(['wins']) && request.resource.data.wins == 1);
      allow update: if isAdmin() || (
        changedOnly(['wins'])
        && request.resource.data.wins == resource.data.wins + 1
        && request.resource.data.wins <= 1200
      );
    }
    // 꽝 공통 QR 참여 수 (개인정보 없음): 1씩만 올릴 수 있음
    match /stats/lose {
      allow create: if isAdmin() || (request.resource.data.keys().hasOnly(['scans']) && request.resource.data.scans == 1);
      allow update: if isAdmin() || (changedOnly(['scans']) && request.resource.data.scans == resource.data.scans + 1);
    }
    // 매장별 공개 집계 (점주 공유 페이지 store.html 용 · 전화번호 없음)
    // scans +1, wins +0/1, amount +당첨금 만 허용
    match /stats/{storeStat} {
      allow create: if isAdmin() || (
        storeStat.matches('store_[0-9]{3}')
        && request.resource.data.keys().hasOnly(['scans','wins','amount'])
        && request.resource.data.scans == 1
        && request.resource.data.wins in [0, 1]
        && request.resource.data.amount in [0, 1000, 5000, 10000, 50000]
      );
      allow update: if isAdmin() || (
        storeStat.matches('store_[0-9]{3}')
        && changedOnly(['scans','wins','amount'])
        && request.resource.data.scans == resource.data.scans + 1
        && (request.resource.data.wins - resource.data.wins) in [0, 1]
        && (request.resource.data.amount - resource.data.amount) in [0, 1000, 5000, 10000, 50000]
      );
    }

    // 그 밖의 모든 경로는 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
